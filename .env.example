# Enheduanna Environment Variables
# Copy to .env and insert your real keys

# Meta Model API key (from https://dev.meta.ai/platform)
META_API_KEY=your_meta_api_key_here

# Optional: Omniroute / OpenAI-compatible endpoint & key
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_key_here

# Service Port
PORT=4100
HOST=127.0.0.1
