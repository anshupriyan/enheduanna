{
  "capture": {
    "interval_seconds": 1.0,
    "hash_threshold": 3,
    "hash_algorithm": "dhash",
    "image_format": "jpeg",
    "image_quality": 85,
    "max_dimension": 0,
    "monitor_mode": "all",
    "capture_active_window_only": false
  },
  "ocr": {
    "primary_engine": "winrt",
    "fallback_engine": "pytesseract",
    "enabled": true,
    "confidence_threshold": 0.0
  },
  "storage": {
    "database_path": "data/memvision.db",
    "screenshots_dir": "data/screenshots",
    "enable_fts": true,
    "retention_days": 30
  },
  "privacy": {
    "config_path": "config/privacy_rules.json",
    "enabled": true
  }
}
