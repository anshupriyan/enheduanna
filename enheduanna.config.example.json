{
  "server": {
    "host": "127.0.0.1",
    "port": 4100
  },
  "model": {
    "provider": "meta",
    "modelName": "muse-spark-1.3",
    "toolModel": "muse-spark-1.3",
    "synthesisModel": "muse-wonder-1.0",
    "baseUrl": "https://api.meta.ai/v1",
    "apiKey": "YOUR_META_API_KEY_HERE"
  },
  "spatial": {
    "enableLocalGeometry": true,
    "enableOpticalOcr": true,
    "enableProjections": false,
    "minSelectionPixels": 16
  },
  "limits": {
    "maxSteps": 16,
    "maxParallelToolCalls": 5,
    "maxToolResultLength": 64000
  },
  "mcpServers": {
    "memvision": {
      "command": "memvison/.venv/Scripts/python.exe",
      "args": ["main.py", "mcp"],
      "cwd": "memvison",
      "env": {
        "MEMVISION_DB_PATH": "./memvison/data/memvision.db",
        "MEMVISION_SCREENSHOTS_DIR": "./memvison/data/screenshots"
      }
    },
    "cli-bridge": {
      "command": "node",
      "args": ["build/index.js", "--policy", "policy.json"],
      "cwd": "../cli-bridge",
      "env": {
        "WORKSPACE_ROOT": "."
      }
    }
  }
}
